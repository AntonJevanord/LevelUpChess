# Keep archived experiment data identical to its recorded upload checksum.
experiments/balance/results/*.summary.json -text
experiments/balance/results/*.uploaded-summary.json -text
experiments/balance/results/*.uploaded-dataset.json -text
experiments/balance/results/*.uploaded-report.json -text
experiments/balance/results/*.replay-source.json -text
# Preserve original collection manifests used by reproducible result audits.
experiments/balance/results/*.collection.json -text
# Preserve the checksum of archived game subsets across Windows checkouts.
experiments/balance/results/*.games.jsonl -text
# Preserve original uploaded reports alongside their recorded checksums.
experiments/balance/results/*.uploaded-report.md -text
# Generated profiles compare canonical INI bytes, including on Windows.
*.ini text eol=lf
# Preserve pinned patch bytes; blank diff context lines contain a space marker.
stockfish/patches/*.patch text eol=lf whitespace=-blank-at-eol
